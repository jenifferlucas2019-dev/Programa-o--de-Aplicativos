// Crie um componente chamado 'OlaMundo' que mostra uma mensagem:
// "Olá, Mundo!!" em uma <div> com o fundo vermelho, texto centralizado na cor
// azul.
// 01
import React from "react";

function OlaMundo() {
  return (
    <div
      style={{
        backgroundColor: "red",
        color: "blue",
        textAlign: "center",
      }}
    >
      Olá, Mundo!!
    </div>
  ); 
}

function App() {
  return (
    <div>
      <OlaMundo />
    </div>
  );
}

export default App;


